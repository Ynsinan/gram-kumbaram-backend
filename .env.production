# ============================================
# PRODUCTION ENVIRONMENT - BACKEND
# ============================================
# Bu dosya production deployment için kullanılır
# Local ayarlar .env.local dosyasındadır

# ============================================
# Database Configuration
# ============================================
# Production PostgreSQL connection
# Dokploy managed PostgreSQL veya external database connection string
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# ============================================
# JWT Configuration
# ============================================
# JWT Secret (Production - GÜÇLÜ BİR ŞİFRE KULLANIN!)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MINIMUM 32 karakter gereklidir!
JWT_SECRET="your-super-secret-production-jwt-key-min-32-chars-REPLACE-THIS"
JWT_EXPIRES_IN="7d"

# ============================================
# Google OAuth (PRODUCTION Client)
# ============================================
# OAUTH_SETUP.md dosyasındaki talimatları izleyerek
# Google Console'da Production OAuth Client oluşturun
GOOGLE_CLIENT_ID="your-production-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-production-client-secret"
GOOGLE_CALLBACK_URL="https://api.gramkumbaram.com/auth/google/callback"

# ============================================
# Server Configuration
# ============================================
PORT=4000
NODE_ENV=production

# ============================================
# Frontend Configuration
# ============================================
# Frontend URL (Production - CORS ve redirects için)
# Multiple origins: separate with comma
FRONTEND_URL="https://gramkumbaram.com"

# ============================================
# Swagger Documentation
# ============================================
# Disable Swagger in production (or enable with basic auth)
ENABLE_SWAGGER=false
# Required if ENABLE_SWAGGER=true
SWAGGER_BASIC_AUTH_USER=admin
SWAGGER_BASIC_AUTH_PASS=your-swagger-password

# ============================================
# Feature Flags (Production)
# ============================================
# Disable debug mode in production
ENABLE_DEBUG=false

# Enable rate limiting in production (RECOMMENDED)
ENABLE_RATE_LIMITING=true

# ============================================
# API Configuration
# ============================================
# API request timeout (milliseconds)
API_TIMEOUT=30000

# Maximum request body size
MAX_REQUEST_SIZE=100kb
