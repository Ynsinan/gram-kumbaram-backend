# ============================================
# PRODUCTION ENVIRONMENT
# ============================================
# Bu dosya production deployment için kullanılır
# Local ayarlar .env.local dosyasındadır

# Database (Production)
# Dokploy managed PostgreSQL veya external database connection string
DATABASE_URL="postgresql://user:password@host:5432/database"

# JWT Secret (Production - GÜÇLÜ BİR ŞİFRE KULLANIN!)
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" ile oluşturun
JWT_SECRET="your-super-secret-production-jwt-key-min-32-chars"

# Google OAuth (PRODUCTION Client)
# OAUTH_SETUP.md dosyasındaki talimatları izleyerek
# Google Console'da Production OAuth Client oluşturun
GOOGLE_CLIENT_ID="your-production-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-production-client-secret"
GOOGLE_CALLBACK_URL="https://api.gramkumbaram.com/auth/google/callback"

# Server Configuration
PORT=4000
NODE_ENV=production

# Frontend URL (Production - CORS ve redirects için)
FRONTEND_URL="https://gramkumbaram.com"
