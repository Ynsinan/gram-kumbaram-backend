# ============================================
# LOCAL DEVELOPMENT ENVIRONMENT - BACKEND
# ============================================
# Bu dosya local geliştirme için kullanılır
# Production ayarları .env.production dosyasındadır

# ============================================
# Database Configuration
# ============================================
# Local PostgreSQL connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gold_wallet?schema=public"

# ============================================
# JWT Configuration
# ============================================
# JWT Secret (Local - production'da farklı ve güçlü olmalı!)
# Minimum 32 karakter gereklidir
JWT_SECRET="local-dev-secret-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# ============================================
# Google OAuth (LOCAL Development Client)
# ============================================
# OAUTH_SETUP.md dosyasındaki talimatları izleyerek
# Google Console'da Local Development OAuth Client oluşturun
GOOGLE_CLIENT_ID="your-local-development-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-local-development-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/auth/google/callback"

# ============================================
# Server Configuration
# ============================================
PORT=4000
NODE_ENV=development

# ============================================
# Frontend Configuration
# ============================================
# Frontend URL (Local - CORS ve redirects için)
FRONTEND_URL="http://localhost:3000"

# ============================================
# Swagger Documentation
# ============================================
# Swagger enabled by default in development
ENABLE_SWAGGER=true
# Optional: Basic auth for Swagger (leave empty for no auth in dev)
SWAGGER_BASIC_AUTH_USER=
SWAGGER_BASIC_AUTH_PASS=

# ============================================
# Feature Flags (Development)
# ============================================
# Enable debug mode (detailed logging, error messages)
ENABLE_DEBUG=true

# Enable rate limiting (set false to disable in development)
ENABLE_RATE_LIMITING=false

# ============================================
# API Configuration
# ============================================
# API request timeout (milliseconds)
API_TIMEOUT=30000

# Maximum request body size
MAX_REQUEST_SIZE=100kb
