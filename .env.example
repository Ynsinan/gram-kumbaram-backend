# ============================================
# ENVIRONMENT VARIABLES EXAMPLE
# ============================================
# Bu dosyayı .env olarak kopyalayın ve kendi değerlerinizle doldurun
# Detaylı talimatlar için OAUTH_SETUP.md dosyasına bakın

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gold_wallet?schema=public"

# JWT Secret (Güçlü bir şifre kullanın!)
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Google OAuth
# OAUTH_SETUP.md dosyasındaki talimatları izleyerek Google Console'dan alın
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/auth/google/callback"

# Server
PORT=4000
NODE_ENV=development

# Frontend URL (for CORS and redirects)
FRONTEND_URL="http://localhost:3000"
