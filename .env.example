# ============================================
# Gold Wallet Backend - Environment Variables
# ============================================
# Kurulum: Bu dosyayi .env olarak kopyalayin ve degerleri doldurun
#   cp .env.example .env

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gold_wallet?schema=public"

# JWT (min 32 karakter)
# Olusturmak icin: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="DEGISTIR-min-32-karakter-secret-key-here"
JWT_EXPIRES_IN="7d"

# Google OAuth
# https://console.cloud.google.com/apis/credentials adresinden olusturun
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/auth/google/callback"

# Server
PORT=4000
NODE_ENV=development

# Frontend (CORS)
FRONTEND_URL="http://localhost:3000"

# Swagger (development: true, production: false)
ENABLE_SWAGGER=true
SWAGGER_BASIC_AUTH_USER=
SWAGGER_BASIC_AUTH_PASS=

# Feature Flags
ENABLE_DEBUG=true
ENABLE_RATE_LIMITING=false

# API
API_TIMEOUT=30000
MAX_REQUEST_SIZE=100kb
