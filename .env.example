# ============================================
# ENVIRONMENT VARIABLES EXAMPLE - BACKEND
# ============================================
# Bu dosyayı .env olarak kopyalayın ve kendi değerlerinizle doldurun
# Local development için: .env.local dosyasını kullanın
# Production için: .env.production dosyasını kullanın
# Detaylı talimatlar için OAUTH_SETUP.md dosyasına bakın

# ============================================
# Database Configuration
# ============================================
# PostgreSQL connection string
# Local: postgresql://postgres:postgres@localhost:5432/gold_wallet?schema=public
# Production: Dokploy managed veya external database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gold_wallet?schema=public"

# ============================================
# JWT Configuration
# ============================================
# JWT Secret (MINIMUM 32 karakter!)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-REPLACE-THIS"
JWT_EXPIRES_IN="7d"

# ============================================
# Google OAuth
# ============================================
# OAUTH_SETUP.md dosyasındaki talimatları izleyerek Google Console'dan alın
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
# Local: http://localhost:4000/auth/google/callback
# Production: https://api.gramkumbaram.com/auth/google/callback
GOOGLE_CALLBACK_URL="http://localhost:4000/auth/google/callback"

# ============================================
# Server Configuration
# ============================================
PORT=4000
# development | production | test
NODE_ENV=development

# ============================================
# Frontend Configuration
# ============================================
# Frontend URL for CORS and redirects
# Local: http://localhost:3000
# Production: https://gramkumbaram.com (multiple: comma-separated)
FRONTEND_URL="http://localhost:3000"

# ============================================
# Swagger Documentation
# ============================================
# Enable Swagger UI (true for development, false for production)
ENABLE_SWAGGER=true
# Optional: Basic auth for Swagger (leave empty for no auth)
SWAGGER_BASIC_AUTH_USER=
SWAGGER_BASIC_AUTH_PASS=

# ============================================
# Feature Flags
# ============================================
# Enable debug mode (detailed logging)
# true for development, false for production
ENABLE_DEBUG=true

# Enable rate limiting
# false for development, true for production
ENABLE_RATE_LIMITING=false

# ============================================
# API Configuration
# ============================================
# API request timeout (milliseconds)
API_TIMEOUT=30000

# Maximum request body size
MAX_REQUEST_SIZE=100kb
